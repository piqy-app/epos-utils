{
  "name": "@piqy/epos-encoder",
  "version": "0.3.0",
  "description": "Encode EPOS abstract syntax trees as ESC/POS printer commands",
  "keywords": [
    "encoder",
    "escpos",
    "pos",
    "printer",
    "receipt"
  ],
  "homepage": "https://github.com/piqy-app/epos-utils/tree/main/packages/epos-encoder#readme",
  "bugs": {
    "url": "https://github.com/piqy-app/epos-utils/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piqy-app/epos-utils.git",
    "directory": "packages/epos-encoder"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "prepublishOnly": "vp pack"
  },
  "dependencies": {
    "@piqy/epos-ast": "workspace:^",
    "@piqy/epos-codepages": "workspace:^",
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
